# API key for OpenAI services
OPENAI_API_KEY=your-api-key-here

# Optional: Whisper model to use (default is "whisper-1")
WHISPER_MODEL=whisper-1

# Optional: Timeout values in seconds
API_TIMEOUT=10

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=ERROR

# Audio sensitivity (lower = more sensitive, higher = less sensitive)
# Adjust based on your environment:
# - For quiet environments: 100-350
# - For normal ambient noise: 350-750
# - For noisy environments: 750-1000
SILENT_THRESHOLD=750

# Minimum audio duration in seconds to be considered valid speech
# Increase this value to filter out false transcriptions from background noise
# Try values like 0.8 or 1.0 if you're getting random gibberish transcriptions
MIN_AUDIO_DURATION_SECONDS=1

# Streaming settings
# Enable streaming mode for real-time transcription (true/false)
USE_STREAMING=true

# Size of audio chunks for streaming in milliseconds
# Smaller values = more responsive but more API calls
# Recommended values: 300-500 for a good balance of responsiveness and efficiency
STREAM_CHUNK_SIZE_MS=250
