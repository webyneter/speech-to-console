# API key for OpenAI services
OPENAI_API_KEY=your-api-key-here

# Optional: Whisper model to use (default is "whisper-1")
WHISPER_MODEL=whisper-1

# Optional: Timeout values in seconds
API_TIMEOUT=10

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Audio sensitivity (lower = more sensitive, higher = less sensitive)
# Default is 100, try 50 for more sensitivity or 200 for less
SILENT_THRESHOLD=100

# Minimum audio duration in seconds to be considered valid speech
# Increase this to filter out false transcriptions from background noise
MIN_AUDIO_DURATION_SECONDS=0.5